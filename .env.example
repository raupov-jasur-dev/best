# Server
PORT=3000
NODE_ENV=production

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/railway

# JWT
JWT_SECRET=uzun-random-secret-kamida-32-belgi
JWT_EXPIRES_IN=7d

# ===== ADMIN LOGIN (Railway Variables) =====
# Server ishga tushganda shu login/parol bilan admin yaratiladi yoki yangilanadi
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SizningKuchliParolingiz

# ===== MEDIA =====
STORAGE_PROVIDER=imgbb
IMGBB_API_KEY=

# Cloudinary (ixtiyoriy — video uchun)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Frontend (Vercel) — CORS
FRONTEND_URL=https://your-app.vercel.app
SITE_BASE_URL=https://your-app.vercel.app

HOME_CAROUSEL_CATEGORY_IDS=1
HOME_TRENDING_CATEGORY_IDS=1,2
HOME_BUXORO_CATEGORY_IDS=1,3
