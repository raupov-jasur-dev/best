# Buxara Best ? examples only. Keep actual credentials in ignored .env / Render.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bukhara_best
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_48_BYTE_SECRET
JWT_EXPIRES_IN=8h
# Existing accounts are never changed at startup. Explicit npm run admin:create only.
ADMIN_USERNAME=
ADMIN_PASSWORD=
STORAGE_PROVIDER=catbox
CATBOX_USERHASH=
FREEIMAGE_API_KEY=
IMGBB_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_DRY_RUN=true
FRONTEND_URL=https://bukharabest.vercel.app
SITE_BASE_URL=https://bukharabest.uz
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
# Require valid DB certificates; set CA when the provider needs it.
DATABASE_CA_CERT=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
SOCIAL_TELEGRAM=https://t.me/Buxarabest
SOCIAL_INSTAGRAM=https://www.instagram.com/buxarabest_/
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
# Additional exact HTTPS hosts allowed for Telegram multipart downloads.
MEDIA_FETCH_HOSTS=
# Required by the static build in Vercel. This is public, never a secret.
PUBLIC_API_URL=https://best-cda1.onrender.com
PUBLIC_SITE_URL=https://bukharabest.vercel.app
