# Server
PORT=3000
NODE_ENV=production

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/railway

# JWT
JWT_SECRET=uzun-random-secret-kamida-32-belgi
JWT_EXPIRES_IN=7d

# ===== MEDIA STORAGE =====
# imgbb  yoki  cloudinary  (bo'sh qoldirsangiz avtomatik tanlanadi)
STORAGE_PROVIDER=imgbb

# ImgBB (rasm uchun — tavsiya, bepul va oddiy)
# https://api.imgbb.com/ → API key oling
IMGBB_API_KEY=

# Cloudinary (ixtiyoriy — video kerak bo'lsa)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Frontend (Vercel domain) — CORS
FRONTEND_URL=https://your-app.vercel.app
SITE_BASE_URL=https://your-app.vercel.app

# Home categories
HOME_CAROUSEL_CATEGORY_IDS=1
HOME_TRENDING_CATEGORY_IDS=1,2
HOME_BUXORO_CATEGORY_IDS=1,3
