<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Bukhara Best</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&family=Inter:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/assets/css/variables.css" rel="stylesheet">
  <link href="/assets/css/main.css" rel="stylesheet">
  <style>
    body { font-family: Inter, sans-serif; }
    .post-card img { height: 200px; object-fit: cover; }
    .hero-img { height: 420px; object-fit: cover; border-radius: 8px; }
    header { background: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
  </style>
</head>
<body>
<header class="py-3 sticky-top bg-white">
  <div class="container d-flex justify-content-between align-items-center">
    <a href="/" class="text-decoration-none"><h1 class="h3 mb-0 text-dark">Bukhara Best</h1></a>
    <nav class="d-none d-md-flex gap-3">
      <a href="/" class="text-dark">Bosh sahifa</a>
      <a href="/post" class="text-dark">Yangiliklar</a>
      <% (categories||[]).slice(0,5).forEach(c => { %>
      <a href="/category/post/<%= c.id %>" class="text-dark"><%= c.name %></a>
      <% }) %>
      <a href="/search" class="text-dark"><i class="bi bi-search"></i></a>
    </nav>
  </div>
</header>

<main class="container py-4">
  <div class="row g-4">
    <div class="col-lg-8">
      <% if (last_post) { %>
      <article class="mb-4">
        <% if (last_post.mainImage) { %><img src="<%= last_post.mainImage %>" class="w-100 hero-img mb-3" alt=""><% } %>
        <span class="badge bg-primary"><%= last_post.category ? last_post.category.name : '' %></span>
        <h2 class="mt-2"><a href="/post/<%= last_post.id %>" class="text-dark text-decoration-none"><%= last_post.title %></a></h2>
        <p class="text-muted"><%= (last_post.shortDescription || '').substring(0, 250) %></p>
        <small class="text-secondary"><%= last_post.publishedAt ? new Date(last_post.publishedAt).toLocaleString('uz-UZ') : '' %> · <%= last_post.views %> ko‘rish</small>
      </article>
      <% } %>
      <div class="row g-3">
        <% (random_seven_posts || []).forEach(p => { %>
        <div class="col-md-6">
          <div class="card post-card h-100 border-0 shadow-sm">
            <% if (p.mainImage) { %><img src="<%= p.mainImage %>" class="card-img-top" alt=""><% } %>
            <div class="card-body">
              <h5 class="card-title"><a href="/post/<%= p.id %>" class="text-dark text-decoration-none"><%= p.title %></a></h5>
              <small class="text-muted"><%= p.views %> ko‘rish</small>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <aside class="col-lg-4">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white fw-bold">So‘nggi yangiliklar</div>
        <ul class="list-group list-group-flush">
          <% (random_posts || []).forEach(p => { %>
          <li class="list-group-item">
            <a href="/post/<%= p.id %>" class="text-dark text-decoration-none"><%= p.title %></a>
            <div class="small text-muted"><%= p.views %> ko‘rish</div>
          </li>
          <% }) %>
        </ul>
      </div>
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-bold">Kategoriyalar</div>
        <ul class="list-group list-group-flush">
          <% (list_categories || []).forEach(c => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <a href="/category/post/<%= c.id %>" class="text-dark text-decoration-none"><%= c.name %></a>
            <span class="badge bg-secondary rounded-pill"><%= c.count_post || 0 %></span>
          </li>
          <% }) %>
        </ul>
      </div>
    </aside>
  </div>
</main>

<footer class="bg-dark text-white py-5 mt-5">
  <div class="container">
    <div class="row">
      <div class="col-md-6">
        <h5>Bukhara Best</h5>
        <p class="small">Rasmiy elektron OAV. Buxoro va Respublika yangiliklari.</p>
      </div>
      <div class="col-md-6 text-md-end">
        <a href="/" class="text-white-50 me-2">Bosh sahifa</a>
        <a href="/post" class="text-white-50 me-2">Yangiliklar</a>
        <a href="/admin" class="text-white-50">Admin</a>
      </div>
    </div>
    <hr class="border-secondary">
    <p class="small mb-0 text-center">© <%= new Date().getFullYear() %> Bukhara Best</p>
  </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
